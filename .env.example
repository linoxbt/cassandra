# Copy to .env (gitignored) — or put these in agent/.env, which is read first.
#
# Everything below is read by the operator scripts in agent/. The contracts and
# the test suites need none of it.

# Passphrase for the encrypted keystores in ~/.genlayer/keystores. `npm run
# setup` creates them under this passphrase; without it they cannot be opened,
# and there is no recovery path. Required by every script that signs.
CASSANDRA_PW=

# Which network to act on: studionet (gasless) or testnetAsimov (needs GEN from
# testnet-faucet.genlayer.foundation). Defaults to studionet.
GL_CHAIN=studionet

# Keystore names. The deployer owns the contracts; the agent is the only account
# allowed to open markets as the agent. Point both at one name to run them as a
# single account, which saves a second faucet claim on a funded network.
DEPLOYER_KS=cassandra-deployer
AGENT_KS=cassandra-agent

# --- optional -------------------------------------------------------------
# Where the keystores live. Defaults to /root/.genlayer/keystores.
# KEYSTORE_DIR=

# Deploy-time contract configuration. Each has a sensible default in deploy.mjs;
# set them only to override. Amounts are in wei.
# TRADING_MIN=300
# TRADING_MAX=2592000
# RESOLVE_WINDOW=259200
# DISPUTE_WINDOW=3600
# ARBITRATION_WINDOW=172800
# MIN_BET=1000000000000000
# MIN_SEED=2000000000000000
# DISPUTE_BOND=100000000000000000
# MIN_JUROR_BOND=100000000000000000
# JUROR_SLASH_BPS=5000
# PROTOCOL_FEE_BPS=0

# Agent loop tuning, read by daemon.mjs.
# TICK_INTERVAL_MS=900000
# TICK_JITTER_MS=90000
# MAX_WRITES_PER_TICK=4
# MAX_OPEN_MARKETS=6

# Override the deployed addresses instead of reading agent/state/deployment.*.json.
# MARKET=0x...
# POSITIONS=0x...
